# Copy to .env and fill in real values. Never commit .env.

# Notion internal integration token (starts with ntn_ or secret_)
NOTION_TOKEN=

# Database IDs (32-char hex from the database URL, with or without dashes)
NOTION_VACANCIES_DB_ID=
NOTION_SKILLS_DB_ID=
NOTION_ROLES_DB_ID=

# Gemini Developer API (Google AI Studio). Model code, not display name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
